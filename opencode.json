{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "opencode-rules@latest"
  ],
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "sudo",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "doas",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "doas *",
      "effect": "deny"
    }
  ],
  "agents": {
    "planner": {},
    "review": {},
    "code-reviewer": {},
    "researcher": {},
    "debugger": {},
    "test-automator": {},
    "information-scan": {},
    "vulnerability-scan": {},
    "codebase": {},
    "docs": {},
    "documentation-engineer": {},
    "performance-engineer": {},
    "refactoring-specialist": {},
    "blogger": {},
    "brutal-critic": {},
    "em-advisor": {},
    "legal-advisor": {},
    "penetration-tester": {},
    "security-auditor": {},
    "orchestrator": {}
  }
}
