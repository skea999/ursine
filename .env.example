# Runtime mode (development | staging | production)
APP_ENV=development

# Server bind (any stack)
HOST=0.0.0.0
PORT=3000

# External API base (any stack)
API_URL=http://localhost:8080

# Auth secrets (optional per project)
# JWT_SECRET=
# SESSION_SECRET=

# LLM provider keys (optional per project)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Logging
LOG_LEVEL=info
