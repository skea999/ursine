# Ursine static-analysis image (Alpine 3.24). Tooling only; the app is not
# containerized.
#
#   podman build -t ursine-static:1 -f ci/Containerfile.static .
#   podman run --rm --network=host -v "$PWD:/work" -w /work \
#     -e CARGO_HOME=/work/artifacts/cargo-home ursine-static:1 sh scripts/static-check.sh
#
# Sources: Alpine 3.24 apk, Alpine edge/testing for cargo-geiger/cargo-machete/
# gitleaks. Documentation checks use ci/Containerfile.docs.

FROM alpine:3.24

# Keep static-tool builds out of the dev target directory.
ENV CARGO_TARGET_DIR=/work/artifacts/static-target

RUN apk add --no-cache \
    bash ca-certificates curl git \
    cargo cargo-deny cargo-audit cargo-cyclonedx \
    typos taplo zizmor actionlint shellcheck shfmt editorconfig-checker \
    && rm -rf /var/cache/apk/*

# edge/testing is tagged explicitly so it cannot silently upgrade unrelated
# 3.24 packages.
RUN echo "@edge https://dl-cdn.alpinelinux.org/alpine/edge/testing" >> /etc/apk/repositories

RUN apk add --no-cache \
    cargo-geiger@edge cargo-machete@edge gitleaks@edge \
    && rm -rf /var/cache/apk/*
